cc_binary {
    name: "vendor.lineage.health-service.meizu",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.health-service.meizu.rc"],
    vintf_fragments: ["vendor.lineage.health-service.meizu.xml"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: [
        "ChargingControl.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.lineage.health-V2-ndk",
    ],
}
