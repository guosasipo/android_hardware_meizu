cc_binary {
    name: "android.hardware.vibrator.service.meizu-richtap",
    vendor: true,
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-DLOG_TAG=\"android.hardware.vibrator.service.meizu\"",
    ],
    relative_install_path: "hw",
    init_rc: ["android.hardware.vibrator.service.meizu-richtap.rc"],
    vintf_fragments: [
        "android.hardware.vibrator.service.meizu-richtap.xml",
    ],
    srcs: [
        "service.cpp",
        "AacVibrator.cpp",
        "RichtapVibrator.cpp",
        "Vibrator.cpp",
    ],
    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "//vendor/meizu/meizu21Pro:libaacvibrator",
        "libbase",
        "libbinder_ndk",
        "liblog",
        "vendor.aac.hardware.richtap.vibrator-V1-ndk",
    ],
}

java_library {
    name: "richtap-api",
    provides_uses_lib: "richtap-api",
    srcs: ["java/richtap/os/PhonyVibrationEffect.java"],
    installable: true,
    platform_apis: true,
    system_ext_specific: true,
}

prebuilt_etc {
    name: "richtap-api.xml",
    src: "richtap-api.xml",
    filename_from_src: true,
    sub_dir: "permissions",
    system_ext_specific: true,
}

android_app {
    name: "MeizuRichTapBridge",
    manifest: "bridge/AndroidManifest.xml",
    srcs: ["bridge/src/com/meizu/richtap/bridge/RichTapProvider.java"],
    static_libs: ["vendor.aac.hardware.richtap.vibrator-V1-java"],
    certificate: "platform",
    platform_apis: true,
    privileged: true,
    system_ext_specific: true,
}
