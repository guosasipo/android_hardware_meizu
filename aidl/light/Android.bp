cc_binary {
    name: "android.hardware.light-service.meizu",
    vendor: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.light-service.meizu.rc"],
    vintf_fragments: ["android.hardware.light-service.meizu.xml"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: [
        "Lights.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.light-V2-ndk",
        "libbase",
        "libbinder_ndk",
        "liblog",
    ],
}
