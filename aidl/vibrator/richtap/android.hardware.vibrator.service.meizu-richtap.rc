on early-boot
    chmod 0660 /dev/aac_richtap_dev
    chown system system /dev/aac_richtap_dev

service vendor.vibrator /vendor/bin/hw/android.hardware.vibrator.service.meizu-richtap
    class hal
    user system
    group system input
    setenv RICHTAP_DEVICE_PATH /dev/aac_richtap_dev
    setenv ENV_RICHTAP_CONFIG_PATH /odm/etc/aac_richtap.config
