cc_binary {
    name: "vendor.meizu.qdp-profile",
    vendor: true,
    init_rc: ["vendor.meizu.qdp-profile.rc"],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
    ],
    srcs: ["QdpProfileProvisioner.cpp"],
    shared_libs: [
        "libdl",
        "liblog",
    ],
}
